# ─────────────────────────────────────────────────────────────────────────────
#  FlipForge configuration
#
#  Copy this file to .env and edit. Everything has a working default except
#  FF_CONTACT, which is required and has no sensible default.
#
#      cp .env.example .env
#      docker compose up -d
#
#  This lists every setting worth changing. Anything you set here is passed
#  through to the API container, and takes effect on the next
#  `docker compose up -d api`.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ Required ════════════════════════════════════════════════════════════════

# Who to contact if this client misbehaves. Sent to the OSRS Wiki in the
# User-Agent as "flipforge/1.0 - <this value>".
#
# The wiki rejects requests that do not identify themselves — default agents
# like python-requests and curl/* get a 400 — so the app refuses to start
# without this rather than emitting a wall of failures that looks like a
# network fault. An email address or Discord handle is fine.
FF_CONTACT=you@example.com


# ═══ Hosting ═════════════════════════════════════════════════════════════════

# Host port for the web UI. 8080 is left alone because it is commonly taken.
FF_PORT=8090

POSTGRES_USER=flipforge
POSTGRES_PASSWORD=flipforge
POSTGRES_DB=flipforge

# Only used when running the API outside Docker. Under Docker Compose the
# connection string is built from the POSTGRES_* values above and this is
# ignored, because the database is reachable as the host `db`.
#FF_DATABASE_URL=postgresql://flipforge:flipforge@localhost:5432/flipforge


# ═══ Grand Exchange tax ══════════════════════════════════════════════════════
#
# 2% of the sale price since 29 May 2025 (it was 1% before that), paid by the
# seller, floored per individual item, and capped per item. Change these and
# every margin, ROI, score, allocation and portfolio figure in the app follows
# on the next API restart — no code change anywhere.

FF_GE_TAX_RATE=0.02
FF_GE_TAX_CAP=5000000

# There is deliberately NO minimum-taxable-price setting.
#
# That threshold is derived from the rate: tax floors per item, so it sits
# wherever floor(price * rate) first reaches 1, which is 50gp at 2%. The widely
# repeated "under 100gp is untaxed" is a leftover from the 1% era, and hardcoding
# it under-reports tax on everything between 50 and 99gp.

# Seed the tax exemption list (bonds, spade, hammer, gloves of silence, ...) on
# first boot. The list is a database table, not a constant: read and edit it at
# /api/config/exemptions and the policy reloads immediately. Set false if you
# maintain the table yourself and do not want the seed reapplied.
FF_SEED_TAX_EXEMPTIONS=true


# ═══ Upstream polling ════════════════════════════════════════════════════════
#
# Every one of these is a single request covering all ~4,000 items, so the
# defaults come to roughly 2 requests per minute for the entire game. The API
# has no hard rate limit precisely because clients behave; please keep it that
# way if you raise these.

FF_POLL_LATEST_SECONDS=45         # every item's current instant-buy / instant-sell
FF_POLL_5M_SECONDS=300            # five-minute averages
FF_POLL_1H_SECONDS=900            # hourly averages
FF_POLL_MAPPING_SECONDS=86400     # item reference data

# Local work only, no upstream requests: recompute the rollup that powers the
# scanner, and evaluate alert rules.
FF_METRICS_INTERVAL_SECONDS=60

# Base URL of the prices API. Only change this to point at a mirror.
FF_WIKI_BASE=https://prices.runescape.wiki/api/v2/osrs


# ═══ First-boot history backfill ═════════════════════════════════════════════
#
# History is built by walking the bulk endpoints backwards. One request covers
# every item for one interval, so 336 hourly steps is two weeks of history for
# the whole game in 336 requests — once, ever. Charts and 24h statistics fill in
# as it runs; the UI is usable immediately.

FF_BACKFILL_ON_START=true
FF_BACKFILL_1H_STEPS=336          # 14 days of hourly candles
FF_BACKFILL_5M_STEPS=288          # 24 hours of five-minute candles
FF_BACKFILL_RATE_PER_SEC=5        # request pacing during backfill


# ═══ Score validation ════════════════════════════════════════════════════════
#
# The flip score is graded rather than trusted. The scoreboard is frozen
# periodically, and once a holding period elapses each frozen row is checked
# against what the market actually did. Results are on the Score check page.

FF_SNAPSHOT_INTERVAL_SECONDS=3600 # how often the scoreboard is frozen
FF_OUTCOME_INTERVAL_SECONDS=1800  # how often matured snapshots are graded

# Hours of score history to rebuild from stored candles on first boot, so the
# Score check page has something to show on day one. These rows are an as-of
# reconstruction using hourly averages rather than live quotes, cannot recover
# quote freshness, and are labelled `reconstructed` throughout. Set 0 to skip
# and wait for real snapshots to accumulate.
FF_RECONSTRUCT_SNAPSHOTS_HOURS=96


# ═══ Slot allocator ══════════════════════════════════════════════════════════

FF_GE_SLOTS_MEMBERS=8
FF_GE_SLOTS_F2P=3

# Diversification cap: no single item may absorb more than this share of your
# bankroll. Never binds tighter than an equal split across your slots would.
FF_ALLOCATOR_MAX_SHARE=0.35


# ═══ Gap filling ═════════════════════════════════════════════════════════════
#
# The first-boot backfill cannot repair an outage: whatever the bulk series
# missed while the stack was stopped stays missing, thinning out the rollup and
# the score validation for that period. This pass finds those holes and refetches
# them, newest first — a hole in the last hour degrades the live scoreboard,
# one from last week only affects a chart.
#
# It repairs holes INSIDE the range already covered. It will not quietly extend
# history further back than the initial backfill reached; that is what
# FF_BACKFILL_1H_STEPS is for.

FF_GAPFILL_ENABLED=true
FF_GAPFILL_INTERVAL_SECONDS=3600

# Ceiling on upstream requests per pass, so a long outage is repaired over
# several passes rather than in one burst.
FF_GAPFILL_MAX_REQUESTS=250

# How far back to repair each resolution. Both are clamped to the retention
# window below, since refetching data that cleanup is about to delete would just
# have the two jobs undoing each other.
FF_GAPFILL_5M_HOURS=48
FF_GAPFILL_1H_DAYS=30

# A bulk window covers the whole game — roughly 1,700 items for 5m and 3,200
# for 1h — so anything far below this is a truncated write rather than a quiet
# market. Windows that come back thin anyway are recorded and not re-requested.
FF_GAPFILL_MIN_ROWS=100


# ═══ Data retention ══════════════════════════════════════════════════════════
#
# Without cleanup the database grows by roughly 550,000 candle rows and 380,000
# score rows per day — on the order of 50GB a year. These windows were chosen by
# checking what actually reads each table, and cap the steady state at a few GB.
#
# Candles are a cache of an upstream API: anything trimmed here can be fetched
# again, and opening an item page repopulates its history on demand. Your
# trades, watchlist, alert rules and tax exemptions are never touched by any of
# this.
#
# Set any window to 0 to disable that particular cleanup.

FF_MAINTENANCE_INTERVAL_SECONDS=86400   # run cleanup daily

# Five-minute candles are ~85% of all growth, and nothing reads them beyond an
# hour old except the 24-hour chart.
FF_RETAIN_5M_DAYS=7

# Hourly candles: score grading reaches back 30 days and the validation page
# allows a 90 day lookback.
FF_RETAIN_1H_DAYS=90

# Backstop for everything else in the candle table, chiefly the 6h and 24h
# resolutions behind the 3-month and 1-year chart timeframes.
FF_RETAIN_CANDLES_DAYS=400

# The app's own score history. Unlike candles this cannot be refetched, only
# approximately reconstructed, so it is kept generously relative to the 90 day
# maximum the validation page can display.
FF_RETAIN_SNAPSHOTS_DAYS=60
FF_RETAIN_OUTCOMES_DAYS=30

FF_RETAIN_ALERT_EVENTS_DAYS=90


# ═══ Scanner defaults ════════════════════════════════════════════════════════

# Quotes older than this are excluded by default. Prices are the last real
# transaction, not a live order book, so a thin item's "current price" can be
# hours stale.
FF_SCANNER_MAX_DATA_AGE_SECONDS=3600
