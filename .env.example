# Copy to .env and edit. Every value here has a working default except FF_CONTACT.

# REQUIRED. The wiki rejects requests that do not identify themselves, and the
# API refuses to start without this rather than failing with a wall of 400s.
# Your email address or Discord handle.
FF_CONTACT=you@example.com

# Port the web UI is served on (8080 is often taken by other projects).
FF_PORT=8090

# --- Database ---------------------------------------------------------------
POSTGRES_USER=flipforge
POSTGRES_PASSWORD=flipforge
POSTGRES_DB=flipforge

# --- Polling ----------------------------------------------------------------
# Seconds between full market price refreshes.
FF_POLL_LATEST_SECONDS=45
# Seconds between rollup recomputes (also when alerts are evaluated).
FF_METRICS_INTERVAL_SECONDS=60

# --- History backfill on first start ----------------------------------------
# Each step is one request covering every item, so 336 hourly steps is 14 days
# of history for the whole game in 336 requests. Runs once, then never again.
FF_BACKFILL_ON_START=true
FF_BACKFILL_1H_STEPS=336
FF_BACKFILL_5M_STEPS=288

# --- Grand Exchange tax -----------------------------------------------------
# 2% of the sale price since 29 May 2025 (it was 1% before that), floored per
# individual item and capped per item. Change these and every margin, ROI,
# score and portfolio figure in the app follows on the next API restart.
#
# There is deliberately no minimum-price setting. The price below which tax
# rounds away to nothing is DERIVED from the rate: at 2% it is 50gp, because
# floor(49 * 0.02) is 0. The widely repeated "under 100gp is untaxed" is a
# leftover from the 1% era and under-reports tax on everything from 50 to 99gp.
FF_GE_TAX_RATE=0.02
FF_GE_TAX_CAP=5000000

# --- Score validation -------------------------------------------------------
# How often the model's claims are snapshotted so they can be graded later
# against what the market actually did.
FF_SNAPSHOT_INTERVAL_SECONDS=3600

# --- Slot allocator ---------------------------------------------------------
FF_GE_SLOTS_MEMBERS=8
FF_GE_SLOTS_F2P=3
# No single item may absorb more than this share of your bankroll.
FF_ALLOCATOR_MAX_SHARE=0.35
