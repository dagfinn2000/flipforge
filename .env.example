# Copy to .env and edit. Every value here has a working default except FF_CONTACT.

# The OSRS Wiki asks API consumers to identify themselves so they can get in
# touch if a client misbehaves. Put your email or Discord handle here.
FF_CONTACT=you@example.com

# Port the web UI is served on (8080 is often taken by other projects).
FF_PORT=8090

# --- Database ---------------------------------------------------------------
POSTGRES_USER=flipforge
POSTGRES_PASSWORD=flipforge
POSTGRES_DB=flipforge

# --- Polling ----------------------------------------------------------------
# Seconds between full market price refreshes.
FF_POLL_LATEST_SECONDS=45
# Seconds between rollup recomputes (also when alerts are evaluated).
FF_METRICS_INTERVAL_SECONDS=60

# --- History backfill on first start ----------------------------------------
# Each step is one request covering every item, so 336 hourly steps is 14 days
# of history for the whole game in 336 requests. Runs once, then never again.
FF_BACKFILL_ON_START=true
FF_BACKFILL_1H_STEPS=336
FF_BACKFILL_5M_STEPS=288

# --- Grand Exchange tax -----------------------------------------------------
# Jagex has changed these before. If an update lands, change them here and
# every margin, ROI and score in the app follows immediately.
FF_GE_TAX_RATE=0.02
FF_GE_TAX_CAP=5000000
FF_GE_TAX_MIN_PRICE=100
